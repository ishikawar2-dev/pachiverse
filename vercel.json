{
  "rewrites": [
    { "source": "/collection", "destination": "/collection.html" },
    { "source": "/transparency", "destination": "/transparency.html" },
    { "source": "/collection/:id(\\d{1,3})", "destination": "/api/machine-page?id=:id" },
    { "source": "/collection/:id(\\d{1,3})/", "destination": "/api/machine-page?id=:id" }
  ],
  "headers": [
    { "source": "/assets/machines/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ],
  "functions": {
    "api/machine-page.js": { "includeFiles": "collection.html" }
  }
}
